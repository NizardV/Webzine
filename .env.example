# ============================================================
# 🐳 WEBZINE DOCKER ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to version control!
# ============================================================

# ┌─────────────────────────────────────────────────────────┐
# │ PostgreSQL Configuration                                │
# └─────────────────────────────────────────────────────────┘

POSTGRES_DB=webzine
POSTGRES_USER=webzine
POSTGRES_PASSWORD=webzine_password

# ⚠️  PRODUCTION WARNING:
# In production, use a STRONG password:
# POSTGRES_PASSWORD=$(openssl rand -base64 32)

# ┌─────────────────────────────────────────────────────────┐
# │ .NET Application Configuration                          │
# └─────────────────────────────────────────────────────────┘

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:7110
ASPNETCORE_HTTPS_PORT=443

# ┌─────────────────────────────────────────────────────────┐
# │ RAG API Configuration                                   │
# └─────────────────────────────────────────────────────────┘

RAG_API_URL=http://rag:8000

# ┌─────────────────────────────────────────────────────────┐
# │ Database Connection String                              │
# └─────────────────────────────────────────────────────────┘

POSTGRES_CONNECTION_STRING=Server=postgres;Port=5432;Database=webzine;User Id=webzine;Password=webzine_password;

# IMPORTANT: Update password to match POSTGRES_PASSWORD above!

# ┌─────────────────────────────────────────────────────────┐
# │ Python & Ollama Configuration                           │
# └─────────────────────────────────────────────────────────┘

PYTHONUNBUFFERED=1

# Ollama endpoint for LLM services
# Windows/macOS Docker Desktop: http://host.docker.internal:11434
# Linux with Ollama on host: http://localhost:11434
# Linux with Ollama in container: http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434

# ┌─────────────────────────────────────────────────────────┐
# │ Logging Configuration                                   │
# └─────────────────────────────────────────────────────────┘

LOGLEVEL=Information

# Options: Trace, Debug, Information, Warning, Error, Critical, None

# ┌─────────────────────────────────────────────────────────┐
# │ Docker Network Configuration                            │
# └─────────────────────────────────────────────────────────┘

# Container hostnames (used internally within Docker network)
POSTGRES_HOST=postgres
RAG_API_HOST=rag
WEBZINE_HOST=webzine

# ┌─────────────────────────────────────────────────────────┐
# │ Port Mappings (localhost)                               │
# └─────────────────────────────────────────────────────────┘

WEBZINE_PORT=7110
RAG_PORT=8000
POSTGRES_PORT=5432
OLLAMA_PORT=11434

# ============================================================
# NOTES & SETUP INSTRUCTIONS
# ============================================================
#
# 1. DATABASE PASSWORD SECURITY:
#    - Change POSTGRES_PASSWORD for any non-local environment
#    - Must match the password in POSTGRES_CONNECTION_STRING
#
# 2. OLLAMA SETUP:
#    - Ensure Ollama is running: ollama serve
#    - Pull a model: ollama pull llama2
#    - Check: ollama list
#
# 3. ENVIRONMENT-SPECIFIC FILES:
#    - Copy this to .env (used by docker-compose up)
#    - For production: create .env.prod with strong credentials
#
# 4. CONNECTION STRINGS:
#    - RAG API: Uses Docker service name (rag) not localhost
#    - PostgreSQL: Uses Docker service name (postgres) not localhost
#    - Ollama: Uses host.docker.internal on Docker Desktop
#
# 5. VERIFY DOCKER SETUP:
#    docker-compose config     # Validate config
#    docker-compose up -d      # Start services
#    docker-compose ps         # Check status
#    docker-compose logs -f    # Watch logs
#
# ============================================================
