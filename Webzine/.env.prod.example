# ============================================
# Production Environment Variables (.env.prod)
# ============================================
# ⚠️  IMPORTANT: Ne JAMAIS committer ce fichier dans Git!
# Utiliser des secrets management tools en production réelle.

POSTGRES_DB=webzine
POSTGRES_USER=webzine
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:7110
RAG_API_URL=http://rag:8000
POSTGRES_CONNECTION_STRING=Server=postgres;Port=5432;Database=webzine;User Id=webzine;Password=CHANGE_ME_SECURE_PASSWORD_HERE;

PYTHONUNBUFFERED=1
OLLAMA_HOST=http://host.docker.internal:11434

LOGLEVEL=Warning

# ============================================
# Instructions de sécurité:
# ============================================
# 1. Générer un password fort pour PostgreSQL
#    Exemple: openssl rand -base64 32
#
# 2. Ne pas committer ce fichier:
#    echo ".env.prod" >> .gitignore
#
# 3. Déployer avec:
#    docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 4. En production réelle, utiliser:
#    - Docker secrets (Swarm)
#    - Kubernetes secrets
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - HashiCorp Vault
# ============================================
