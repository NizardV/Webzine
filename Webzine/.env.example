# ============================================
# 🐳 Docker Compose Environment Variables
# ============================================

# PostgreSQL Configuration
POSTGRES_DB=webzine
POSTGRES_USER=webzine
POSTGRES_PASSWORD=webzine_password

# .NET Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:7110
RAG_API_URL=http://rag:8000
POSTGRES_CONNECTION_STRING=Server=postgres;Port=5432;Database=webzine;User Id=webzine;Password=webzine_password;

# Python RAG Configuration
PYTHONUNBUFFERED=1
OLLAMA_HOST=http://host.docker.internal:11434

# Logging
LOGLEVEL=Information

# ============================================
# Configuration Notes:
# ============================================
# - RAG_API_URL: Utilise le nom du service Docker (rag) au lieu de localhost
# - POSTGRES_CONNECTION_STRING: Utilise le nom du service Docker (postgres)
# - OLLAMA_HOST: Sur Windows/Mac Docker Desktop, utiliser host.docker.internal
#   Pour Linux/Ollama en conteneur, utiliser http://ollama:11434
# - ⚠️  En production, TOUJOURS changer POSTGRES_PASSWORD et utiliser des secrets
# ============================================
