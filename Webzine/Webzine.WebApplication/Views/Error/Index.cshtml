@model Webzine.WebApplication.ViewModels.ErrorViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container text-center mt-5">
    <h1 class="display-1 text-danger fw-bold">@Model.StatusCode</h1>
    <h2 class="mb-4">@Model.Title</h2>
    
    <p class="lead text-muted">
        @Model.Message
    </p>

    <div class="mt-5">
        <a asp-controller="Home" asp-action="Index" asp-area="" class="btn btn-primary btn-lg">
            Retourner à l'accueil
        </a>
    </div>
</div>