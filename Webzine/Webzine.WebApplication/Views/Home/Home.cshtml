@model IEnumerable<Webzine.WebApplication.ViewModels.TitreModel>

@{
    ViewData["Title"] = "Derniers titres chroniqués";
}

<h1 class="h3 mb-4">Derniers titres chroniqués</h1>

<div class="list-group">
    @foreach (var item in Model)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-start">
                <div class="me-3">
                    <div class="fw-semibold">@item.Titre.Libelle</div>
                    <div class="text-muted small">@item.Titre.DateSortie.ToString("dd/MM/yyyy")</div>
                    <div class="mt-2">@item.Titre.Chronique</div>
                    <div class="mt-3">
                        <a asp-controller="Home"
                           asp-action="DetailTitre"
                           asp-route-id="@item.Titre.IdTitre"
                           class="btn btn-primary btn-sm">
                            Lire la suite
                        </a>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(item.Titre.UrlJaquette))
                {
                    <img src="@item.Titre.UrlJaquette" alt="Jaquette" class="img-thumbnail" style="width: 96px; height: 96px; object-fit: cover;" />
                }
            </div>
        </div>
    }
</div>
