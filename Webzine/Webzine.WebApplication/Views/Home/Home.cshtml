@model Webzine.WebApplication.ViewModels.ListeTitreModel

@{
    ViewData["Title"] = "Derniers titres chroniqués";
}

<h1 class="h3 mb-4">Derniers titres chroniqués</h1>

@if (Model?.Titres is null || !Model.Titres.Any())
{
    <div class="alert alert-secondary" role="alert">Aucun titre.</div>
}
else
{
    <div class="list-group">
        @foreach (var titre in Model.Titres)
        {
            <div class="list-group-item">
                <div class="d-flex flex-column flex-md-row gap-3">
                    <div class="flex-shrink-0" style="width:120px">
                        <div class="bg-body-tertiary border" style="width:120px;height:80px"></div>
                    </div>
                   <div class="flex-grow-1">
                        <div class="fw-semibold">@titre.Libelle</div>
                        <div class="text-muted small">
                            @titre.DateSortie.ToString("dd/MM/yyyy")
                            @if (titre.Styles is not null && titre.Styles.Any())
                            {
                                <span> • @string.Join(", ", titre.Styles.Select(s => s.Libelle))</span>
                            }
                        </div>
                        <div class="mt-2 text-body-secondary">@titre.Chronique</div>
                        <div class="mt-2">
                            <a class="btn btn-primary btn-sm" href="#">Lire la suite</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
