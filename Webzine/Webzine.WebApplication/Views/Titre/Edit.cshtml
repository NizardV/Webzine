@model Webzine.Entity.Titre

@{
    ViewData["Title"] = "Éditer un titre";
}

<h1 class="h3 mb-4">Éditer un titre</h1>

<form class="row g-3" asp-controller="Titre" asp-action="Edit" asp-route-id="@Model.IdTitre" method="post">
    @Html.AntiForgeryToken()
    <div class="col-12 col-md-8">
        <label class="form-label">Titre</label>
        <input class="form-control" value="@Model.Libelle" disabled />
    </div>

    <div class="col-12 col-md-4">
        <label class="form-label">Durée</label>
        <input class="form-control" value="@Model.Duree.ToString("mm':'ss")" disabled />
    </div>

    <div class="col-12">
        <label class="form-label">Chronique</label>
        <textarea class="form-control" rows="6" name="chronique">@Model.Chronique</textarea>
    </div>

    <div class="col-12 d-flex justify-content-between">
        <a class="btn btn-secondary" asp-controller="Titre" asp-action="Details" asp-route-id="@Model.IdTitre">Annuler</a>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    </div>
</form>
