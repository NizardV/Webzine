@model IEnumerable<Webzine.Entity.Artiste>

@{
    ViewData["Title"] = "Artistes";
}

<div class="mt-4">
    <h2>Artistes</h2>

    <hr class="mb-4" />

    <div class="mb-3">
        <a asp-area="Administration" asp-controller="Artiste" asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Ajouter un nouvel artiste
        </a>
    </div>

    <table class="table table-striped table-hover align-middle border">
        <thead class="table-light">
            <tr>
                <th>Nom de l'artiste</th>
                <th class="text-center" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var artiste in Model)
            {
                <tr>
                    <td>@artiste.Nom</td>
                    <td class="text-center">
                        <a asp-area="Administration" asp-controller="Artiste" asp-action="Edit" asp-route-id="@artiste.IdArtiste" class="text-primary text-decoration-none me-3" title="Éditer">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <a asp-area="Administration" asp-controller="Artiste" asp-action="Delete" asp-route-id="@artiste.IdArtiste" class="text-primary text-decoration-none" title="Supprimer">
                            <i class="bi bi-trash3"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>