@model Webzine.Entity.Artiste

@{
    ViewData["Title"] = "Détails de l'artiste";
}

<div class="mt-4">
    <h2>Détails de l'artiste</h2>

    <hr class="mb-4" />

    <div class="row mb-4">
        <div class="col-sm-2 fw-bold">Nom</div>
        <div class="col-sm-10">@Model.Nom</div>
    </div>

    <div class="row mb-4">
        <div class="col-sm-2 fw-bold">Biographie</div>
        <div class="col-sm-10">
            <p class="mb-0">@Model.Biographie</p>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <a asp-area="Administration" asp-controller="Artiste" asp-action="Edit" asp-route-id="@Model.IdArtiste" class="btn btn-primary">
            Éditer
        </a>
        <a asp-area="Administration" asp-controller="Artiste" asp-action="Index" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    </div>
</div>
