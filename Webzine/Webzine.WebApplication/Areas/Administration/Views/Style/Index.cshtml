@model IEnumerable<Webzine.Entity.Style>



<div class="mt-4">
    <h2>Styles</h2>
    <hr />

    <div class="mb-3">
        <a href="" class="btn btn-primary">
            + Ajouter un nouvel style
        </a>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Libellé</th>
                <th class="text-center" style="width: 100px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var style in Model)
            {
                <tr>
                    <td class="align-middle">@style.Libelle</td>
                    <td class="text-center align-middle">
                        <a href="" class="text-primary text-decoration-none me-2" title="Éditer">
                            Editer
                        </a>
                        <a href="" class="text-primary text-decoration-none" title="Supprimer">
                            Suppr.
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>