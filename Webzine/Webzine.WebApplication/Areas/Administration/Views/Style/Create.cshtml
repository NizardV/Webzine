@model Webzine.Entity.Style
@{

}
<div class="mt-4">
    <h2>Créer un style</h2>

    <hr class="mb-4" />

    <form asp-area="Administration" asp-controller="Style" asp-action="Create" method="post">

        <div class="row g-3 align-items-center mb-5">

            <div class="col-auto">
                <label for="Libelle" class="col-form-label">
                    Libellé<span class="text-danger">*</span>
                </label>
            </div>

            <div class="col-auto">
                <input type="text" id="Libelle" name="Libelle" class="form-control" required />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Sauvegarder</button>
            </div>

        </div>
    </form>

    <div>
        <a asp-area="Administration" asp-controller="Style" asp-action="Index" class="text-decoration-none">Retour à l'administration des styles</a>
    </div>
</div>