@model Webzine.Entity.Style

@{
    ViewData["Title"] = "Détails du style";
}

<div class="mt-4">
    <h2>Détails du style</h2>

    <hr class="mb-4" />

    <div class="row mb-4">
        <div class="col-sm-2 fw-bold">Libellé</div>
        <div class="col-sm-10">@Model.Libelle</div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <a asp-area="Administration" asp-controller="Style" asp-action="Edit" asp-route-id="@Model.IdStyle" class="btn btn-primary">
            Éditer
        </a>
        <a asp-area="Administration" asp-controller="Style" asp-action="Index" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    </div>
</div>
