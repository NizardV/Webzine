@model Webzine.WebApplication.Areas.Administration.ViewModel.Dashboard.DashboardViewModel


    <h1>Tableau de bord</h1>
    <hr class="hr" />

    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-primary">
                        <i class="bi bi-people-fill display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.NbArtistes</h1>
                        <p class="small">artistes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-primary">
                        <i class="bi bi-person-fill display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.ArtistesPlusChroniques</h1>
                        <p class="small">artiste le plus chroniqué</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-primary">
                        <i class="bi bi-trophy-fill display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.ArtistePlusAlbums</h1>
                        <p class="small">artiste avec le plus de titres provenant d'albums distincts</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-primary">
                        <i class="bi bi-journal display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.NbBiographiesArtistes</h1>
                        <p class="small">biographies d'artistes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-primary">
                        <i class="bi bi-disc-fill display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.TitrePlusLu</h1>
                        <p class="small">titre le plus lu</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-primary">
                        <i class="bi bi-music-note-beamed display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.NbTitres</h1>
                        <p class="small">titres</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-primary">
                        <i class="bi bi-tags-fill display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.NbStyles</h1>
                        <p class="small">styles de musique</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-eye-fill display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.NbLectures</h1>
                        <p class="small">lectures</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-hand-thumbs-up-fill display-5 mb-3"></i>
                        <h1 class="fs-2 fw-bold mb-1">@Model.NbLikes</h1>
                        <p class="small">likes</p>
                    </div>
                </div>
            </div>

        </div>
    </div>