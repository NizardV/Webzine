@model Webzine.Entity.Commentaire

@{
    ViewData["Title"] = "Éditer un commentaire";
}

<div class="mt-4">
    <h2>Éditer un commentaire</h2>

    <hr class="mb-4" />

    <form asp-area="Administration" asp-controller="Commentaire" asp-action="Edit" asp-route-id="@Model.IdCommentaire" method="post">

        <input type="hidden" name="IdCommentaire" value="@Model.IdCommentaire" />

        <div class="row mb-4">
            <label for="Auteur" class="col-sm-2 col-form-label">
                Auteur<span class="text-danger">*</span>
            </label>
            <div class="col-sm-10">
                <input type="text" id="Auteur" name="Auteur" class="form-control" value="@Model.Auteur" required />
                <span asp-validation-for="Auteur" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-4">
            <label for="Contenu" class="col-sm-2 col-form-label">
                Contenu<span class="text-danger">*</span>
            </label>
            <div class="col-sm-10">
                <textarea id="Contenu" name="Contenu" class="form-control" rows="6" required>@Model.Contenu</textarea>
                <span asp-validation-for="Contenu" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-4">
            <label for="IdTitre" class="col-sm-2 col-form-label">
                Titre<span class="text-danger">*</span>
            </label>
            <div class="col-sm-10">
                <input type="number" id="IdTitre" name="IdTitre" class="form-control" value="@Model.IdTitre" required />
                <span asp-validation-for="IdTitre" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Sauvegarder</button>
            </div>
        </div>

    </form>

    <div>
        <a asp-area="Administration" asp-controller="Commentaire" asp-action="Commentaires" class="text-decoration-none">
            Retour à l'administration des commentaires
        </a>
    </div>
</div>
