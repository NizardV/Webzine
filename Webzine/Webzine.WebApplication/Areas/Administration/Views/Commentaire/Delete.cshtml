@model Webzine.Entity.Commentaire

@{
    ViewData["Title"] = "Supprimer un commentaire";
}
<h1>Supprimer un commentaire</h1>
<p>Êtes-vous sûr de vouloir supprimer le commentaire suivant ?</p>
<h3>@Model.Contenu</h3>
<p>- <strong>@Model.Auteur</strong> le @Model.DateCreation sur @Model.Titre.Libelle</p>
<form asp-area="Administration" asp-controller="Commentaire" asp-action="DeleteConfirmed" asp-route-id="@Model.IdCommentaire" method="post">
    <button type="submit" class="btn btn-danger">Supprimer</button>
</form>
<br />
<a asp-area="Administration" asp-controller="Commentaire" asp-action="Commentaires">
    <p class="text-primary">Retour à l'administration des commentaires</p>
</a>
