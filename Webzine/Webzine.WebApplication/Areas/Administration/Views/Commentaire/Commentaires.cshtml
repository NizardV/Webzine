@{
    <h1>Commentaires</h1>
    <hr class="hr" />
    <table class="table table-striped table-bordered border-secondary text-center">
        <thead>
            <tr class="table-secondary fw-bold">
                <td>Titre</td>
                <td>Nom</td>
                <td>Commentaire</td>
                <td>Date de création</td>
                <td>Actions</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var commentaire in Model.Commentaires)
            {
                <tr class="table-light">
                    <td><a asp-area="" asp-controller="Titre" asp-action="DetailsTitre" asp-route-id="@commentaire.Titre.IdTitre">@commentaire.Titre.Libelle</a></td>
                    <td>@commentaire.Auteur</td>
                    <td>@commentaire.Contenu</td>
                    <td>@commentaire.DateCreation</td>
                    <td>
                        <a asp-area="Administration" asp-controller="Commentaire" asp-action="Supprimer" asp-route-id="@commentaire.IdCommentaire">
                            <i class="bi bi-trash3-fill text-primary"></i>
                        </a>
                    </td>            
                </tr>
            }
        </tbody>
    </table>
}
